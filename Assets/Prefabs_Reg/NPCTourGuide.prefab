  spriteToggleInterval: 3
  dialogueCamera: {fileID: 0}
  npcLensSize: 4.5
  onDialogueEnd:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 3549110012235057317}
        m_TargetAssemblyTypeName: NPCTourGuide, Assembly-CSharp
        m_MethodName: Interact
        m_Mode: 1
