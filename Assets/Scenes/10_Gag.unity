    - target: {fileID: 3861689419981878179, guid: 6b1d1205fca65b54f80052f8b622d4d1, type: 3}
      propertyPath: DialogueLines.Array.size
      value: 11
      objectReference: {fileID: 0}
    - target: {fileID: 3861689419981878179, guid: 6b1d1205fca65b54f80052f8b622d4d1, type: 3}
      propertyPath: 'DialogueLines.Array.data[0]'
      value: "Hah\u2026Rasanya miris sekali ya"
      objectReference: {fileID: 0}
    - target: {fileID: 3861689419981878179, guid: 6b1d1205fca65b54f80052f8b622d4d1, type: 3}
      propertyPath: 'DialogueLines.Array.data[1]'
      value: Hatiku rasanya sakit sekali
      objectReference: {fileID: 0}
    - target: {fileID: 3861689419981878179, guid: 6b1d1205fca65b54f80052f8b622d4d1, type: 3}
      propertyPath: 'DialogueLines.Array.data[2]'
      value: Di saat pulau-pulau lain yang kita kunjungi begitu dijaga keindahannya
        untuk pariwisata
      objectReference: {fileID: 0}
    - target: {fileID: 3861689419981878179, guid: 6b1d1205fca65b54f80052f8b622d4d1, type: 3}
      propertyPath: 'DialogueLines.Array.data[3]'
      value: "Di tempat ini\u2026 alamnya malah dikorbankan demi kepentingan industri   "
      objectReference: {fileID: 0}
    - target: {fileID: 3861689419981878179, guid: 6b1d1205fca65b54f80052f8b622d4d1, type: 3}
      propertyPath: 'DialogueLines.Array.data[4]'
      value: 'Melihat air laut keruh ini dan mendengar nasib warga lokal di sini,
        makin menyadarkanku... '
      objectReference: {fileID: 0}
    - target: {fileID: 3861689419981878179, guid: 6b1d1205fca65b54f80052f8b622d4d1, type: 3}
      propertyPath: 'DialogueLines.Array.data[5]'
      value: 'Ekowisata itu bukan cuma soal jalan-jalan senang dan foto-foto bagus  '
      objectReference: {fileID: 0}
    - target: {fileID: 3861689419981878179, guid: 6b1d1205fca65b54f80052f8b622d4d1, type: 3}
      propertyPath: 'DialogueLines.Array.data[6]'
      value: Tapi juga tentang membuka mata, peduli pada krisis lingkungan yang terjadi
      objectReference: {fileID: 0}
    - target: {fileID: 3861689419981878179, guid: 6b1d1205fca65b54f80052f8b622d4d1, type: 3}
      propertyPath: 'DialogueLines.Array.data[7]'
      value: 'Dan juga bersuara untuk menjaga apa yang tersisa '
      objectReference: {fileID: 0}
    - target: {fileID: 3861689419981878179, guid: 6b1d1205fca65b54f80052f8b622d4d1, type: 3}
      propertyPath: 'DialogueLines.Array.data[8]'
      value: 'Terima kasih ya sudah mau melangkah sampai ke pulau ini dan membantu
        warga di sini '
      objectReference: {fileID: 0}
    - target: {fileID: 3861689419981878179, guid: 6b1d1205fca65b54f80052f8b622d4d1, type: 3}
      propertyPath: 'DialogueLines.Array.data[9]'
      value: Ayo, naik ke perahu
      objectReference: {fileID: 0}
    - target: {fileID: 3861689419981878179, guid: 6b1d1205fca65b54f80052f8b622d4d1, type: 3}
      propertyPath: 'DialogueLines.Array.data[10]'
      value: Kita berlayar kembali ke Pelabuhan Waisai untuk mengakhiri perjalanan
        ini
      objectReference: {fileID: 0}
